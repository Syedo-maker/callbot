# Copy to .env and fill in. Never commit the real .env.

# Post-call outcome classifier (Claude). Leave empty to rely on the agent-reported outcome only.
ANTHROPIC_API_KEY=
# Default is claude-opus-5. Set claude-haiku-4-5 to cut classifier cost ~5x (see docs/01-cost-estimate.md).
CLASSIFIER_MODEL=claude-opus-5

# Managed voice platform (Phase 1 target: Vapi)
VAPI_API_KEY=
# Filled in by npm run vapi:sync (first run prints them)
VAPI_ASSISTANT_ID_FEMALE=
VAPI_ASSISTANT_ID_MALE=
# Filled in by npm run vapi:telephony -- byo-trunk|twilio --apply
VAPI_SIP_CREDENTIAL_ID=
VAPI_PHONE_NUMBER_ID_PK=
VAPI_PHONE_NUMBER_ID_INTL=
# Public HTTPS URL that forwards to the webhook server (e.g. https://xxxx.ngrok.app/vapi/webhook)
VAPI_WEBHOOK_URL=
# Random string, 16+ chars. Also create it in Vapi as a bearer-token credential and put that credential's ID below.
VAPI_WEBHOOK_BEARER_TOKEN=
VAPI_SERVER_CREDENTIAL_ID=
PORT=3000

# Twilio (international numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# SBC (Asterisk) between Vapi and the Pakistani carrier — see telephony/sbc/README.md
SBC_PUBLIC_IP=
SBC_LOCAL_NET=10.0.0.0/8
SBC_SIP_USERNAME=
SBC_SIP_PASSWORD=
# Vapi SIP signalling IPs, comma-separated (from Vapi docs/support)
VAPI_SIP_IPS=
CARRIER_HOST=
CARRIER_PORT=5060
CARRIER_USERNAME=
CARRIER_PASSWORD=
# University UAN in E.164 (for Vapi) and in the carrier's local format (for the SBC)
UNIVERSITY_CALLER_ID=+9242111000000
UNIVERSITY_CALLER_ID_LOCAL=042111000000
MAX_CHANNELS=10

# Campaign
UNIVERSITY_NAME="Your University"

# Phase 0 provider bake-off (npm run bakeoff)
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
