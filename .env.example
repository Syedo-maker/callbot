# Copy to .env and fill in. Never commit the real .env.

# Post-call outcome classifier (Claude). Leave empty to rely on the agent-reported outcome only.
ANTHROPIC_API_KEY=
# Default is claude-opus-5. Set claude-haiku-4-5 to cut classifier cost ~5x (see docs/01-cost-estimate.md).
CLASSIFIER_MODEL=claude-opus-5

# Managed voice platform (Phase 1 target: Vapi)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID_FEMALE=
VAPI_ASSISTANT_ID_MALE=
# Public HTTPS URL that receives end-of-call-report webhooks
VAPI_WEBHOOK_URL=
VAPI_WEBHOOK_BEARER_TOKEN=

# Campaign
UNIVERSITY_NAME="Your University"

# Phase 0 provider bake-off (npm run bakeoff)
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
